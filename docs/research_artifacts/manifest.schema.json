{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:cross-asset-market-intelligence:research-artifacts:v1:manifest",
  "title": "Signal research manifest envelope v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "artifact_standard_version",
    "research_id",
    "research_version",
    "run_id",
    "subject",
    "research_status",
    "dataset",
    "execution",
    "methodology_candidates",
    "artifacts",
    "conditional_omissions",
    "validation_status",
    "decision_status",
    "reproducibility_notes"
  ],
  "properties": {
    "artifact_standard_version": {
      "const": "research_artifacts_v1"
    },
    "research_id": {
      "$ref": "#/definitions/stableId"
    },
    "research_version": {
      "$ref": "#/definitions/stableId"
    },
    "run_id": {
      "type": "string",
      "pattern": "^run_sha256:[0-9a-f]{64}$"
    },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["component_id", "indicator_ids"],
      "properties": {
        "signal_id": {
          "type": ["string", "null"],
          "minLength": 1
        },
        "proposed_signal_id": {
          "type": ["string", "null"],
          "minLength": 1
        },
        "component_id": {
          "$ref": "#/definitions/stableId"
        },
        "indicator_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/definitions/stableId"
          }
        }
      },
      "anyOf": [
        {
          "required": ["signal_id"],
          "properties": {
            "signal_id": {"type": "string"}
          }
        },
        {
          "required": ["proposed_signal_id"],
          "properties": {
            "proposed_signal_id": {"type": "string"}
          }
        }
      ]
    },
    "research_status": {
      "$ref": "#/definitions/researchDecision"
    },
    "dataset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "applicability",
        "observation_count",
        "first_observation_date",
        "last_observation_date",
        "selected_input_snapshot_hash",
        "snapshot_identity_profile",
        "input_selection_rule",
        "source_ids",
        "series_ids",
        "vintage_summary",
        "availability_summary",
        "not_applicable_reason"
      ],
      "properties": {
        "applicability": {
          "enum": ["selected_observations", "not_applicable"]
        },
        "observation_count": {
          "type": "integer",
          "minimum": 0
        },
        "first_observation_date": {
          "$ref": "#/definitions/nullableDate"
        },
        "last_observation_date": {
          "$ref": "#/definitions/nullableDate"
        },
        "selected_input_snapshot_hash": {
          "anyOf": [
            {"$ref": "#/definitions/sha256"},
            {"type": "null"}
          ]
        },
        "snapshot_identity_profile": {
          "enum": ["canonical_selected_inputs_v1", "not_applicable"]
        },
        "input_selection_rule": {
          "type": "string",
          "minLength": 1
        },
        "source_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "series_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "vintage_summary": {
          "type": "object"
        },
        "availability_summary": {
          "type": "object"
        },
        "not_applicable_reason": {
          "type": ["string", "null"],
          "minLength": 1
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {"applicability": {"const": "selected_observations"}}
          },
          "then": {
            "properties": {
              "observation_count": {"minimum": 1},
              "first_observation_date": {"type": "string", "format": "date"},
              "last_observation_date": {"type": "string", "format": "date"},
              "selected_input_snapshot_hash": {"$ref": "#/definitions/sha256"},
              "snapshot_identity_profile": {"const": "canonical_selected_inputs_v1"},
              "not_applicable_reason": {"type": "null"}
            }
          },
          "else": {
            "properties": {
              "observation_count": {"const": 0},
              "first_observation_date": {"type": "null"},
              "last_observation_date": {"type": "null"},
              "selected_input_snapshot_hash": {"type": "null"},
              "snapshot_identity_profile": {"const": "not_applicable"},
              "not_applicable_reason": {"type": "string", "minLength": 1}
            }
          }
        }
      ]
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "executed_at",
        "git_commit",
        "git_commit_unavailable_reason",
        "working_tree_state",
        "working_tree_diff_hash",
        "research_entrypoint",
        "research_code_files",
        "research_code_hash",
        "validator_entrypoint",
        "validator_code_files",
        "validator_code_hash",
        "runtime"
      ],
      "properties": {
        "executed_at": {
          "type": "string",
          "format": "date-time"
        },
        "git_commit": {
          "type": ["string", "null"],
          "pattern": "^[0-9a-f]{40,64}$"
        },
        "git_commit_unavailable_reason": {
          "type": ["string", "null"],
          "minLength": 1
        },
        "working_tree_state": {
          "enum": ["clean", "dirty", "unavailable"]
        },
        "working_tree_diff_hash": {
          "anyOf": [
            {"$ref": "#/definitions/sha256"},
            {"type": "null"}
          ]
        },
        "research_entrypoint": {
          "$ref": "#/definitions/repoPath"
        },
        "research_code_files": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/definitions/codeFile"}
        },
        "research_code_hash": {
          "$ref": "#/definitions/sha256"
        },
        "validator_entrypoint": {
          "$ref": "#/definitions/repoPath"
        },
        "validator_code_files": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/definitions/codeFile"}
        },
        "validator_code_hash": {
          "$ref": "#/definitions/sha256"
        },
        "runtime": {
          "type": "object",
          "additionalProperties": false,
          "required": ["language", "version", "environment_reference", "environment_hash"],
          "properties": {
            "language": {"type": "string", "minLength": 1},
            "version": {"type": "string", "minLength": 1},
            "environment_reference": {
              "anyOf": [
                {"$ref": "#/definitions/repoPath"},
                {"type": "null"}
              ]
            },
            "environment_hash": {
              "anyOf": [
                {"$ref": "#/definitions/sha256"},
                {"type": "null"}
              ]
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {"working_tree_state": {"const": "dirty"}}
          },
          "then": {
            "properties": {
              "git_commit": {"type": "string", "pattern": "^[0-9a-f]{40,64}$"},
              "working_tree_diff_hash": {"$ref": "#/definitions/sha256"}
            }
          }
        },
        {
          "if": {
            "properties": {"working_tree_state": {"const": "clean"}}
          },
          "then": {
            "properties": {
              "git_commit": {"type": "string", "pattern": "^[0-9a-f]{40,64}$"},
              "git_commit_unavailable_reason": {"type": "null"},
              "working_tree_diff_hash": {"type": "null"}
            }
          }
        },
        {
          "if": {
            "properties": {"git_commit": {"type": "null"}}
          },
          "then": {
            "properties": {
              "git_commit_unavailable_reason": {"type": "string", "minLength": 1}
            }
          }
        }
      ]
    },
    "methodology_candidates": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["candidate_id", "parameters", "configuration_reference"],
        "properties": {
          "candidate_id": {"$ref": "#/definitions/stableId"},
          "parameters": {"type": "object"},
          "configuration_reference": {
            "anyOf": [
              {"$ref": "#/definitions/repoPath"},
              {"type": "null"}
            ]
          }
        }
      }
    },
    "artifacts": {
      "type": "array",
      "minItems": 4,
      "items": {
        "$ref": "#/definitions/artifact"
      }
    },
    "conditional_omissions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["logical_name", "status", "rationale"],
        "properties": {
          "logical_name": {"$ref": "#/definitions/stableId"},
          "status": {"const": "not_applicable"},
          "rationale": {"type": "string", "minLength": 1}
        }
      }
    },
    "validation_status": {
      "$ref": "#/definitions/validationStatus"
    },
    "decision_status": {
      "$ref": "#/definitions/researchDecision"
    },
    "reproducibility_notes": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    }
  },
  "definitions": {
    "stableId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._:-]*$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "repoPath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?![A-Za-z]:)(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
    },
    "nullableDate": {
      "anyOf": [
        {"type": "string", "format": "date"},
        {"type": "null"}
      ]
    },
    "researchDecision": {
      "enum": [
        "READY_FOR_METHODOLOGY_FREEZE",
        "MORE_RESEARCH_REQUIRED",
        "BLOCKED_BY_DATA_OR_ARCHITECTURE"
      ]
    },
    "validationStatus": {
      "enum": ["passed", "passed_with_warnings", "failed"]
    },
    "column": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "logical_type", "unit", "description", "null_semantics"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "logical_type": {
          "enum": ["string", "integer", "number", "boolean", "date", "timestamp", "json"]
        },
        "unit": {"type": "string", "minLength": 1},
        "description": {"type": "string", "minLength": 1},
        "null_semantics": {"type": "string", "minLength": 1}
      }
    },
    "codeFile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["relative_path", "raw_file_hash"],
      "properties": {
        "relative_path": {"$ref": "#/definitions/repoPath"},
        "raw_file_hash": {"$ref": "#/definitions/sha256"}
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "logical_name",
        "relative_path",
        "artifact_type",
        "media_type",
        "requirement",
        "raw_file_hash",
        "authoritative_for",
        "storage_policy",
        "external_reference",
        "columns",
        "column_schema_path",
        "row_count"
      ],
      "properties": {
        "logical_name": {"$ref": "#/definitions/stableId"},
        "relative_path": {
          "anyOf": [
            {"$ref": "#/definitions/repoPath"},
            {"type": "null"}
          ]
        },
        "artifact_type": {
          "enum": ["json", "csv", "markdown", "notebook", "code", "image", "other"]
        },
        "media_type": {"type": "string", "minLength": 1},
        "requirement": {"enum": ["mandatory", "conditional", "optional"]},
        "raw_file_hash": {"$ref": "#/definitions/sha256"},
        "authoritative_for": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "storage_policy": {
          "enum": ["committed", "regenerable_not_committed", "external_reference"]
        },
        "external_reference": {
          "type": ["string", "null"],
          "minLength": 1
        },
        "columns": {
          "type": "array",
          "items": {"$ref": "#/definitions/column"}
        },
        "column_schema_path": {
          "anyOf": [
            {"$ref": "#/definitions/repoPath"},
            {"type": "null"}
          ]
        },
        "row_count": {
          "type": ["integer", "null"],
          "minimum": 0
        }
      }
    }
  }
}
