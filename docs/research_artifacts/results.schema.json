{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:cross-asset-market-intelligence:research-artifacts:v1:results",
  "title": "Signal research results envelope v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "artifact_standard_version",
    "research_id",
    "research_version",
    "run_id",
    "research_status",
    "measured_facts",
    "research_interpretations",
    "design_recommendations",
    "method_comparison_summary",
    "recommended_evidence_design",
    "recommended_horizon_or_reference_design",
    "state_recommendation",
    "known_failure_modes",
    "indicator_specific_findings",
    "deferred_questions",
    "production_readiness_decision"
  ],
  "properties": {
    "artifact_standard_version": {"const": "research_artifacts_v1"},
    "research_id": {"$ref": "#/definitions/stableId"},
    "research_version": {"$ref": "#/definitions/stableId"},
    "run_id": {"type": "string", "pattern": "^run_sha256:[0-9a-f]{64}$"},
    "research_status": {"$ref": "#/definitions/researchDecision"},
    "measured_facts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["fact_id", "statement", "evidence_refs", "value", "unit"],
        "properties": {
          "fact_id": {"$ref": "#/definitions/stableId"},
          "statement": {"type": "string", "minLength": 1},
          "evidence_refs": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "minLength": 1}
          },
          "value": {},
          "unit": {"type": ["string", "null"], "minLength": 1}
        }
      }
    },
    "research_interpretations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["interpretation_id", "statement", "based_on_fact_ids", "limitations"],
        "properties": {
          "interpretation_id": {"$ref": "#/definitions/stableId"},
          "statement": {"type": "string", "minLength": 1},
          "based_on_fact_ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"$ref": "#/definitions/stableId"}
          },
          "limitations": {
            "type": "array",
            "items": {"type": "string", "minLength": 1}
          }
        }
      }
    },
    "design_recommendations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["recommendation_id", "statement", "basis_refs"],
        "properties": {
          "recommendation_id": {"$ref": "#/definitions/stableId"},
          "statement": {"type": "string", "minLength": 1},
          "basis_refs": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "minLength": 1}
          }
        }
      }
    },
    "method_comparison_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["applicability", "artifact_ref", "rationale"],
      "properties": {
        "applicability": {"enum": ["performed", "not_applicable"]},
        "artifact_ref": {"type": ["string", "null"], "minLength": 1},
        "rationale": {"type": "string", "minLength": 1}
      }
    },
    "recommended_evidence_design": {"type": "object"},
    "recommended_horizon_or_reference_design": {"type": ["object", "null"]},
    "state_recommendation": {
      "type": "object",
      "additionalProperties": true,
      "required": ["decision", "rationale"],
      "properties": {
        "decision": {"enum": ["none", "proposed", "deferred", "not_applicable"]},
        "rationale": {"type": "string", "minLength": 1}
      }
    },
    "known_failure_modes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["failure_mode_id", "description", "evidence_refs", "blocking"],
        "properties": {
          "failure_mode_id": {"$ref": "#/definitions/stableId"},
          "description": {"type": "string", "minLength": 1},
          "evidence_refs": {
            "type": "array",
            "items": {"type": "string", "minLength": 1}
          },
          "blocking": {"type": "boolean"}
        }
      }
    },
    "indicator_specific_findings": {"type": "object"},
    "deferred_questions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["question_id", "question", "blocking"],
        "properties": {
          "question_id": {"$ref": "#/definitions/stableId"},
          "question": {"type": "string", "minLength": 1},
          "blocking": {"type": "boolean"}
        }
      }
    },
    "production_readiness_decision": {"$ref": "#/definitions/researchDecision"}
  },
  "definitions": {
    "stableId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._:-]*$"
    },
    "researchDecision": {
      "enum": [
        "READY_FOR_METHODOLOGY_FREEZE",
        "MORE_RESEARCH_REQUIRED",
        "BLOCKED_BY_DATA_OR_ARCHITECTURE"
      ]
    }
  }
}
